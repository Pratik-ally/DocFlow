{
  "name": "medipriority",
  "version": "1.0.0",
  "description": "MediPriority AI - Hospital Appointment & Patient Priority Management Backend",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "test": "tsx --test src/tests/teamEndpoints.test.ts src/tests/hospitalRegistration.test.ts",
