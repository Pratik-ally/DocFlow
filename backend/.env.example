PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://localhost:27017/medipriority?replicaSet=rs0
SESSION_SECRET=replace_with_at_least_32_random_characters
# Legacy alias; use SESSION_SECRET as the single configured signing secret.
JWT_SECRET=
JWT_EXPIRES_IN=7d
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
DEMO_PASSWORD=

# Required in production to deliver hospital-owner verification codes.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
