# Copy to .env and replace every value before running Docker Compose.
# Keep MongoDB passwords alphanumeric so they can be used safely in the URI.
MONGO_ROOT_USERNAME=docflow_admin
MONGO_ROOT_PASSWORD=
MONGO_APP_USERNAME=docflow_app
MONGO_APP_PASSWORD=

# SMTP sender used for owner email verification in production.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# Generate unique 32+ character secrets with a cryptographic random generator.
SESSION_SECRET=
AUTH_SECRET=
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=
NEXTAUTH_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3000
SERVER_ACTIONS_ALLOWED_ORIGINS=
