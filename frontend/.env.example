# ─── Required ────────────────────────────────────────────────────────────────

# MongoDB connection string (local or MongoDB Atlas)
MONGODB_URI=mongodb://localhost:27017/medipriority

# Auth.js — generate with: openssl rand -hex 32
AUTH_SECRET=

# Google OAuth 2.0 credentials (Google Cloud Console)
AUTH_GOOGLE_ID=
AUTH_GOOGLE_SECRET=

# ─── Optional ─────────────────────────────────────────────────────────────────

# Full URL of this site (required in production)
# Development: http://localhost:3000
# Production:  https://your-app.vercel.app
NEXTAUTH_URL=http://localhost:3000

# Express backend URL used by the Next.js same-origin API proxy.
# Use the backend service hostname in Docker, or 127.0.0.1 locally.
NEXT_PUBLIC_API_URL=http://127.0.0.1:5000

# Must exactly match backend/.env.local JWT_SECRET for bridged sessions.
JWT_SECRET=
